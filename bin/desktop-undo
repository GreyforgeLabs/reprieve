#!/usr/bin/env bash
# CLI + keybind wrapper. Close always falls back to killactive so Super+W
# never becomes a no-op if the plugin is disabled or the shell is restarting.
set -u

PLUGIN_ID="io.github.greyforgelabs.desktop-undo"
ACTION="${1:-status}"

ipc() {
  local method="$1"
  timeout 0.4 omarchy-shell "$PLUGIN_ID" "$method" 2>/dev/null || true
}

close_active() {
  # Hyprland 0.56 Lua config: hyprctl dispatch is a lua shorthand.
  hyprctl dispatch "hl.dsp.window.close()" >/dev/null 2>&1 || hyprctl dispatch killactive >/dev/null 2>&1 || true
}

case "$ACTION" in
  close)
    result="$(ipc close)"
    case "$result" in
      parked|ok|empty) exit 0 ;;
      *) close_active; exit 0 ;;
    esac
    ;;
  kill|permanent)
    result="$(ipc kill)"
    case "$result" in
      killed|ok|empty) exit 0 ;;
      *) close_active; exit 0 ;;
    esac
    ;;
  reset)
    result="$(ipc reset)"
    printf '%s\n' "${result:-reset}"
    ;;
  undo|redo|status)
    result="$(ipc "$ACTION")"
    if [[ -n "$result" ]]; then
      printf '%s\n' "$result"
      exit 0
    fi
    echo "desktop-undo: plugin not running" >&2
    exit 1
    ;;
  timeline)
    omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null 2>&1 || true
    ;;
  *)
    echo "usage: desktop-undo close|kill|undo|redo|status|timeline|reset" >&2
    exit 2
    ;;
esac
