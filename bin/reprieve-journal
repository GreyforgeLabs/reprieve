#!/usr/bin/env sh
# Native journal when built; portable Python fallback for plugin installs.
case $0 in
    */*) HERE=${0%/*} ;;
    *) HERE=$(command -v -- "$0"); HERE=${HERE%/*} ;;
esac
if [ -x "$HERE/reprieve-journal-native" ]; then
    exec "$HERE/reprieve-journal-native" "$@"
fi
exec python3 "$HERE/reprieve-journal.py" "$@"
