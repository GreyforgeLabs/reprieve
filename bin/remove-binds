#!/usr/bin/env bash
# Remove only this plugin's marked block from bindings.lua.
set -euo pipefail

PLUGIN_ID="io.github.greyforgelabs.desktop-undo"
config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"

if [[ ! -f "$config" ]]; then
  echo "desktop-undo: no $config"
  exit 0
fi
if [[ -L "$config" ]]; then
  echo "desktop-undo: refusing to follow symlink $config" >&2
  exit 1
fi
if ! grep -Fq "$PLUGIN_ID" "$config"; then
  echo "desktop-undo: no marked bindings to remove"
  exit 0
fi

backup="$config.bak.$(date +%Y%m%d%H%M%S)"
cp -p "$config" "$backup"

python3 - "$config" "$PLUGIN_ID" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
plugin = re.escape(sys.argv[2])
text = path.read_text()
text, n = re.subn(
    rf"\n?-- BEGIN {plugin}.*?-- END {plugin}\n?",
    "\n",
    text,
    flags=re.S,
)
if n == 0:
    raise SystemExit("desktop-undo: marker block not found")
path.write_text(text)
PY

if hyprctl reload >/dev/null 2>&1; then
  echo "desktop-undo: bindings removed and Hyprland reloaded"
else
  echo "desktop-undo: bindings removed; reload Hyprland if Super+W is still parked"
fi
