#!/usr/bin/env python3
"""Pause matching MPRIS players without changing persistent mixer state.

Stdlib + busctl; pactl is used only to clean up older journals' mute records.
Players without MPRIS pause support keep playing. Browsers can share one
player across windows, so parking a window may pause playback in another.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import time

# Hard cap so a wedged PipeWire/DBus after sleep cannot stall omarchy-shell.
LIMIT_S = 2.0
_deadline = 0.0


def begin() -> None:
    global _deadline
    _deadline = time.monotonic() + LIMIT_S


def remaining() -> float:
    return _deadline - time.monotonic()


def parent_of(pid: int) -> int:
    try:
        with open(f"/proc/{pid}/stat", "rt", encoding="utf-8") as fh:
            stat = fh.read()
        # The command name may contain spaces and parentheses; ppid follows
        # the state field after the last ")".
        return int(stat[stat.rfind(")") + 2 :].split()[1])
    except (OSError, IndexError, ValueError):
        return 0


def window_pids(root: int, names: list[str]) -> set[int]:
    """PIDs written in the player names that belong to root's process tree.

    player_matches() accepts a PID only as a whole number inside the name, so
    these are the only members of the window's process tree that can matter.
    Walking up from each candidate reads a few /proc entries instead of the
    stat file of every process on the system.
    """
    found: set[int] = set()
    if root <= 0:
        return found
    for name in names:
        for run in re.findall(r"\d+", name):
            if run != str(int(run)):
                continue  # a leading zero never matches a PID
            candidate = current = int(run)
            if candidate in found:
                continue
            for _ in range(256):
                if current == root:
                    found.add(candidate)
                    break
                if current <= 1:
                    break
                current = parent_of(current)
    return found


def parse_sink_inputs(text: str) -> list[dict]:
    out: list[dict] = []
    current: dict | None = None
    index_re = re.compile(r"^Sink Input #(\d+)")
    for line in text.splitlines():
        match = index_re.match(line)
        if match:
            if current:
                out.append(current)
            current = {"index": int(match.group(1)), "mute": False, "pid": 0, "name": "", "binary": ""}
            continue
        if current is None:
            continue
        stripped = line.strip()
        if stripped.startswith("Mute:"):
            current["mute"] = stripped.split(":", 1)[1].strip().lower() in ("yes", "true", "1")
        elif "application.process.id" in stripped:
            value = stripped.split("=", 1)[-1].strip().strip('"')
            try:
                current["pid"] = int(value)
            except ValueError:
                current["pid"] = 0
        elif stripped.startswith("application.name"):
            current["name"] = stripped.split("=", 1)[-1].strip().strip('"')
        elif "application.process.binary" in stripped:
            current["binary"] = stripped.split("=", 1)[-1].strip().strip('"')
    if current:
        out.append(current)
    return out


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    left = remaining()
    if left <= 0:
        return subprocess.CompletedProcess(cmd, 1, "", "timeout")
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=min(1.0, left))
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 1, "", "timeout")


MPRIS_NAME = re.compile(r'"(org\.mpris\.MediaPlayer2\.[A-Za-z0-9_.-]+)"')


def mpris_names() -> list[str]:
    # ListNames returns only names that are currently owned, in one bus
    # call. `busctl list` also lists activatable names (a property read on
    # one of those starts the service) and resolves every peer's
    # credentials, which costs several times as long.
    result = run([
        "busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
        "org.freedesktop.DBus", "ListNames",
    ])
    if result.returncode != 0:
        return []
    return list(dict.fromkeys(MPRIS_NAME.findall(result.stdout)))


def mpris_status(name: str) -> str:
    result = run([
        "busctl", "--user", "get-property", name,
        "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus",
    ])
    if result.returncode != 0:
        return ""
    # s "Playing"
    text = result.stdout.strip()
    if '"' in text:
        return text.split('"')[1]
    return text.replace("s ", "", 1).strip()


def mpris_call(name: str, method: str) -> bool:
    result = run([
        "busctl", "--user", "call", name,
        "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method,
    ])
    return result.returncode == 0


def class_tokens(klass: str) -> list[str]:
    k = (klass or "").lower()
    tokens = [k]
    if "chrome" in k or "chromium" in k or "brave" in k:
        tokens.extend(["chrom", "brave", "google-chrome"])
    if "firefox" in k:
        tokens.extend(["firefox", "gecko"])
    if "spotify" in k:
        tokens.append("spotify")
    if "mpv" in k:
        tokens.append("mpv")
    if "vlc" in k:
        tokens.append("vlc")
    return [t for t in tokens if t]


def player_matches(name: str, pids: set[int], klass: str) -> bool:
    low = name.lower()
    for pid in pids:
        try:
            pid_int = int(pid)
        except (TypeError, ValueError):
            continue
        if pid_int <= 0:
            continue
        # A PID must match as a whole number, not as a substring of a longer
        # ID: pid 86 must not match "...instance5868".
        if re.search(r"(?<!\d)%d(?!\d)" % pid_int, low):
            return True
    tokens = class_tokens(klass)
    short = low.split("org.mpris.mediaplayer2.", 1)[-1]
    for token in tokens:
        if token and token in short:
            return True
    return False


def pause(pid: int, klass: str) -> dict:
    begin()
    # WirePlumber saves mute per application. A stream can disappear during
    # Pause, browser idle, or process exit; restoring its old index cannot
    # undo that saved mute. Never use persistent mixer controls for parking.
    paused: list[str] = []
    names = mpris_names()
    if not names:
        return {"muted": [], "paused": paused}
    pids = window_pids(pid, names)
    for name in names:
        # Matching is local; only matching players cost a bus round trip.
        if not player_matches(name, pids, klass):
            continue
        if mpris_status(name) != "Playing":
            continue
        if mpris_call(name, "Pause"):
            paused.append(name)
    return {"muted": [], "paused": paused}


def resume(payload: dict) -> dict:
    begin()
    muted = payload.get("muted") or []
    paused = payload.get("paused") or []
    # Compatibility with journals from releases that muted on park. Never
    # guess a replacement by application name: its mute may be intentional.
    sinks = []
    if muted:
        listed = run(["pactl", "list", "sink-inputs"])
        sinks = parse_sink_inputs(listed.stdout) if listed.returncode == 0 else []
    by_index = {s["index"]: s for s in sinks}
    unmuted = 0
    for item in muted:
        if not isinstance(item, dict):
            continue
        try:
            index = int(item.get("index") or 0)
            pid = int(item.get("pid") or 0)
        except (TypeError, ValueError):
            continue
        sink = by_index.get(index)
        if not sink:
            continue
        if not pid or sink["pid"] != pid:
            continue
        if run(["pactl", "set-sink-input-mute", str(index), "0"]).returncode == 0:
            unmuted += 1
    played = 0
    if not isinstance(paused, list):
        paused = []
    for name in paused:
        if not isinstance(name, str) or not name:
            continue
        if mpris_status(name) == "Paused":
            if mpris_call(name, "Play"):
                played += 1
    return {"unmuted": unmuted, "played": played}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["pause", "resume"])
    parser.add_argument("--pid", type=int, default=0)
    parser.add_argument("--class-name", default="")
    parser.add_argument("--payload", default="")
    args = parser.parse_args()
    if args.action == "pause":
        json.dump(pause(args.pid, args.class_name), sys.stdout)
        return 0
    payload = {}
    try:
        if args.payload:
            payload = json.loads(args.payload)
        else:
            raw = sys.stdin.read().strip()
            payload = json.loads(raw) if raw else {}
    except ValueError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    json.dump(resume(payload), sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
