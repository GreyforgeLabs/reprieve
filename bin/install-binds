#!/usr/bin/env bash
# Idempotent Super+W / Super+Z bindings. Never binds Ctrl+Z.
set -euo pipefail

PLUGIN_ID="io.github.greyforgelabs.desktop-undo"
config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
plugin_dir="$(cd "$(dirname "$0")/.." && pwd)"
close_cmd="$plugin_dir/bin/desktop-undo close"
kill_cmd="$plugin_dir/bin/desktop-undo kill"
undo_cmd="$plugin_dir/bin/desktop-undo undo"
redo_cmd="$plugin_dir/bin/desktop-undo redo"

mkdir -p "$(dirname "$config")"
if [[ -e "$config" && ! -f "$config" ]]; then
  echo "desktop-undo: refusing to write $config (not a regular file)" >&2
  exit 1
fi
if [[ -L "$config" ]]; then
  echo "desktop-undo: refusing to follow symlink $config" >&2
  exit 1
fi
touch "$config"

if grep -Fq "$PLUGIN_ID" "$config"; then
  echo "desktop-undo: bindings already present"
  exit 0
fi

backup="$config.bak.$(date +%Y%m%d%H%M%S)"
cp -p "$config" "$backup"

# Drop the previous desktop-undo experiment if those markers are still around.
if grep -Fq "io.github.chris.desktop-undo" "$config"; then
  python3 - "$config" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
text = re.sub(
    r"\n?-- BEGIN io\.github\.chris\.desktop-undo.*?-- END io\.github\.chris\.desktop-undo\n?",
    "\n",
    text,
    flags=re.S,
)
path.write_text(text)
PY
fi

{
  printf '\n-- BEGIN %s\n' "$PLUGIN_ID"
  printf 'hl.unbind("SUPER + W")\n'
  printf 'hl.unbind("SUPER + Z")\n'
  printf 'hl.unbind("SUPER + Y")\n'
  printf 'hl.unbind("SUPER + SHIFT + Z")\n'
  printf 'o.bind("SUPER + W", "Close window (undoable)", [=[%s]=])\n' "$close_cmd"
  printf 'o.bind("SUPER + ALT + W", "Close window permanently", [=[%s]=])\n' "$kill_cmd"
  printf 'o.bind("SUPER + Z", "Desktop undo", hl.dsp.global("%s:undo"))\n' "$PLUGIN_ID"
  printf 'o.bind("SUPER + Y", "Desktop redo", hl.dsp.global("%s:redo"))\n' "$PLUGIN_ID"
  printf 'o.bind("SUPER + SHIFT + Z", "Desktop undo timeline", "omarchy-shell shell summon %s")\n' "$PLUGIN_ID"
  printf 'hl.window_rule({ match = { workspace = "special:desktop-undo" }, no_anim = true })\n'
  printf 'hl.layer_rule({ match = { namespace = "omarchy-desktop-undo" }, no_anim = true, animation = "none" })\n'
  printf 'hl.layer_rule({ match = { namespace = "omarchy-desktop-undo-toast" }, no_anim = true, animation = "none" })\n'
  printf -- '-- END %s\n' "$PLUGIN_ID"
} >> "$config"

chmod +x "$plugin_dir/bin/desktop-undo" "$plugin_dir/bin/media" "$plugin_dir/bin/install-binds" "$plugin_dir/bin/remove-binds" 2>/dev/null || true

if hyprctl reload >/dev/null 2>&1; then
  echo "desktop-undo: bindings installed and Hyprland reloaded"
else
  echo "desktop-undo: bindings saved; reload Hyprland if Super+W still kills"
fi
